<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">League Companion</string>

    <!-- Debug screen: временный, выбрасывается вместе с экранами вехи 11–12. -->
    <string name="debug_title">Backend smoke test</string>
    <string name="debug_game_name">Game name</string>
    <string name="debug_tag_line">Tag line</string>
    <string name="debug_region">Region</string>
    <string name="debug_track">Track summoner</string>
    <string name="debug_refresh">Refresh matches</string>
    <string name="debug_no_summoner">No summoner tracked yet</string>
    <string name="debug_no_matches">No matches yet — the backend syncs them in the background</string>
    <string name="debug_never_synced">never synced</string>

    <!-- Ошибки. Формулировки разные не для красоты: 401 значит, что приложение
         настроено неверно, а 502 — что сервер не смог достучаться до Riot. -->
    <string name="error_no_network">No connection to the backend. Is it running?</string>
    <string name="error_unauthorized">Wrong API key. Check LC_API_KEY in local.properties.</string>
    <string name="error_not_found">Summoner not found.</string>
    <string name="error_rate_limited">Rate limited. Try again in %1$d s.</string>
    <string name="error_riot_unavailable">The backend cannot reach Riot API. Its key may have expired.</string>
    <string name="error_server">Backend error %1$d. Check its logs.</string>
    <string name="error_unknown">Something went wrong.</string>

    <!-- Общие действия. -->
    <string name="action_retry">Retry</string>
    <string name="action_back">Back</string>
    <string name="action_load_more">Load more</string>

    <!-- Экран саммонера. -->
    <string name="summoner_title_fallback">Summoner</string>
    <string name="summoner_missing">This summoner is no longer tracked.</string>
    <string name="summoner_no_matches">No matches yet — they arrive after the first sync.</string>
    <string name="profile_region_level">%1$s · level %2$d</string>
    <string name="profile_unranked">Unranked this season</string>
    <string name="profile_queue_rank">%1$s: %2$s %3$s · %4$d LP</string>
    <string name="profile_record">%1$dW %2$dL · %3$s win rate</string>
    <string name="queue_solo">Solo/Duo</string>
    <string name="queue_flex">Flex</string>

    <!-- Карточка матча. Исход дублируется словом, а не только цветом: при
         дальтонизме зелёная и красная карточки различаются только оттенком. -->
    <string name="match_victory">Victory</string>
    <string name="match_defeat">Defeat</string>
    <string name="match_score">%1$s · KDA %2$s</string>
    <string name="match_details">%1$s · %2$d CS · %3$s</string>

    <!-- «Сколько прошло» для карточки матча. Через plurals, а не конкатенацией:
         в английском «1 minute» и «2 minutes» — разные формы, и склеенное
         "$n minutes" врало бы на каждой первой минуте. -->
    <string name="ago_just_now">just now</string>
    <plurals name="ago_minutes">
        <item quantity="one">%1$d minute ago</item>
        <item quantity="other">%1$d minutes ago</item>
    </plurals>
    <plurals name="ago_hours">
        <item quantity="one">%1$d hour ago</item>
        <item quantity="other">%1$d hours ago</item>
    </plurals>
    <plurals name="ago_days">
        <item quantity="one">%1$d day ago</item>
        <item quantity="other">%1$d days ago</item>
    </plurals>
</resources>
