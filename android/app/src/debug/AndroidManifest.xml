<?xml version="1.0" encoding="utf-8"?>
<!--
  Бэкенд на этапе разработки слушает обычный HTTP, а начиная с targetSdk 28
  Android режет cleartext: первый же запрос упал бы с
  «CLEARTEXT communication to 10.0.2.2 not permitted».

  Послабление живёт только в debug-варианте и только для двух адресов, поэтому
  release-сборка остаётся HTTPS-only — а не «ослаблено временно и так и осталось».
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="24" />

</manifest>
