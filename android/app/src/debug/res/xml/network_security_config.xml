<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Только debug-сборка: в ней бэкенд бывает на чём угодно — 10.0.2.2 внутри
      эмулятора, 10.0.3.2 в Genymotion, localhost через adb reverse, произвольный
      IP тестового сервера. Перечислять их поимённо значит вписывать адреса машин
      в репозиторий и править конфиг при каждом переезде.

      На release это не распространяется: там networkSecurityConfig не подключён,
      и действует умолчание платформы — с API 28 cleartext запрещён. То есть
      боевая сборка по-прежнему требует HTTPS, и послабление живёт ровно там, где
      им пользуется разработчик.
    -->
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
