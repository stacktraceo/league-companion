# Скопируй в .env и подставь свои значения:  cp .env.example .env
#
# Этот файл читают оба сценария запуска:
#   - docker compose (env_file в docker-compose.yml);
#   - локальный запуск бэкенда — config.LoadDotEnv() ищет .env и в корне, и в backend/.
# Сам .env в git не попадает (см. .gitignore).

# Development Key с https://developer.riotgames.com — протухает раз в 24 часа
# и обновляется вручную (SPEC.md 3.2, риск в SPEC.md 7).
RIOT_API_KEY=RGAPI-00000000-0000-0000-0000-000000000000

# Shared secret между Android-клиентом и бэкендом: проверяется middleware
# в заголовке X-API-Key на всех /api/v1/* (DECISIONS.md, отклонение 3).
# Сгенерировать: openssl rand -hex 32
CLIENT_API_KEY=change-me-to-a-random-secret

# debug | info | warn | error
LOG_LEVEL=info

# Таймаут одного запроса к Riot API.
RIOT_HTTP_TIMEOUT=10s

# Как часто просыпается фоновая синхронизация. 0 — выключить совсем.
SYNC_INTERVAL=10m

# --- Дальше — только для запуска БЕЗ docker-compose. -------------------------
# В compose эти три значения задаются в docker-compose.yml (хосты postgres и redis)
# и перекрывают то, что написано здесь.
DATABASE_URL=postgres://league:league@localhost:5432/league_companion?sslmode=disable
REDIS_ADDR=localhost:6379
HTTP_PORT=8080
